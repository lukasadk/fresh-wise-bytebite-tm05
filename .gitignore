# ---------------------------------------------------------------
# FreshWise -- single .gitignore for the whole repo (mobile + backend)
# Keep all rules here. Do not add per-folder .gitignore files.
# ---------------------------------------------------------------

# --- Dependencies -----------------------------------------------
node_modules/

# --- Expo / React Native ----------------------------------------
.expo/
.expo-shared/
dist/
web-build/
android/.gradle/
android/build/
android/app/build/
.gradle-build-home/
*.class
modules/*/android/.cxx/
modules/*/android/build/
modules/*/android/src/main/jniLibs/
android/app/src/main/assets/wastewise-vlm/
artifacts/
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# --- Python / FastAPI backend -----------------------------------
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environment & secrets --------------------------------------
.env
.env.local
.env.*.local

# --- Logs -------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.Rhistory
*.tmp

# --- OS ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDE ----------------------------------------------
.vscode/
.idea/
*.swp

# Scratch output from scripts/verify-storage-guidance.mjs
.verify-tmp/

# Local AI model downloads/restores. Keep model weights out of normal Git.
ai model/downloads/
ai model/models/
ai model/**/*.safetensors
ai model/**/*.bin
