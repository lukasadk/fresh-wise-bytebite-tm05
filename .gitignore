# ---------------------------------------------------------------
# FreshWise -- single .gitignore for the whole repo (mobile + backend)
# Keep all rules here. Do not add per-folder .gitignore files.
# ---------------------------------------------------------------

# --- Dependencies -----------------------------------------------
node_modules/

# --- Expo / React Native ----------------------------------------
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# --- Python / FastAPI backend -----------------------------------
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environment & secrets --------------------------------------
.env
.env.local
.env.*.local

# --- Logs -------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDE ----------------------------------------------
.vscode/
.idea/
*.swp
