# Copy to .env and fill in your own values. .env is gitignored -- never commit it.
#
# These are read by Expo at build time. The EXPO_PUBLIC_ prefix is required for
# the app to see them, and it also means they are COMPILED INTO THE BUNDLE:
# treat anything here as public, not secret.
#
# After editing .env, restart Metro with a cleared cache or the old values stay
# baked in:   npx expo start -c

# Where the Railway backend lives.
EXPO_PUBLIC_API_BASE_URL=https://<your-freshwise-api>.up.railway.app

# Only needed when the server has API_KEY set (i.e. a public deployment).
# Leave empty for local/Tailscale development.
EXPO_PUBLIC_API_KEY=

# WasteWise grocery-AI gateway. Use the same Railway URL only if that service
# exposes /v1/api-recognition/* and /v1/recipe-rag/recommend.
EXPO_PUBLIC_GROCERY_AI_API_URL=https://<your-ai-gateway>.up.railway.app

# Optional public client/service token matching WW_SERVICE_API_KEY on the AI
# gateway. This is compiled into the APK, so NEVER put the model provider key here.
EXPO_PUBLIC_GROCERY_AI_SERVICE_KEY=
