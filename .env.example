# Copy to .env and fill in your own values. .env is gitignored -- never commit it.
#
# These are read by Expo at build time. The EXPO_PUBLIC_ prefix is required for
# the app to see them, and it also means they are COMPILED INTO THE BUNDLE:
# treat anything here as public, not secret.
#
# After editing .env, restart Metro with a cleared cache or the old values stay
# baked in:   npx expo start -c

# Where the API lives.
#   Local dev, phone on the same Wi-Fi : http://<your-laptop-LAN-IP>:8000
#   Hosted on Railway                  : https://<your-app>.up.railway.app
EXPO_PUBLIC_API_BASE_URL=http://100.108.18.20:8000

# Only needed when the server has API_KEY set (i.e. a public deployment).
# Leave empty for local/Tailscale development.
EXPO_PUBLIC_API_KEY=
