# Copy to .env and fill in your own values. .env is gitignored -- never commit it.
#
# These are read by Expo at build time. The EXPO_PUBLIC_ prefix is required for
# the app to see them, and it also means they are COMPILED INTO THE BUNDLE:
# treat anything here as public, not secret.
#
# After editing .env, restart Metro with a cleared cache or the old values stay
# baked in:   npx expo start -c

# Where the Railway backend lives. This URL is public and safe to commit.
EXPO_PUBLIC_API_BASE_URL=https://wastewise-ai-api-production.up.railway.app

# Optional public client key matching backend API_KEY.
# This is compiled into the app/APK, so leave it empty unless you understand
# that it is not a real secret. Do not put the upstream model provider key here.
EXPO_PUBLIC_API_KEY=

# WasteWise grocery-AI gateway. The hosted Railway service keeps the real model
# key on the server and exposes only the app-facing recognition endpoints.
EXPO_PUBLIC_GROCERY_AI_API_URL=https://wastewise-ai-api-production.up.railway.app

# Optional public client/service token matching WW_SERVICE_API_KEY on the AI
# gateway. This is compiled into the APK, so NEVER put the model provider key here.
EXPO_PUBLIC_GROCERY_AI_SERVICE_KEY=
