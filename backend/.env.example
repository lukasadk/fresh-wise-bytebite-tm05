# Copy to .env and fill in. .env is git-ignored -- never commit real values.

# --- Database -----------------------------------------------------------
# Local development (Postgres on the NAS over Tailscale):
DATABASE_URL=postgresql+asyncpg://freshwise_api:PASSWORD@100.x.x.x:5433/freshwise_db
DATABASE_URL_SYNC=postgresql+psycopg://freshwise_api:PASSWORD@100.x.x.x:5433/freshwise_db
#
# On a managed platform (Railway/Render/Neon) only DATABASE_URL is injected,
# with no +driver suffix. app/config.py normalises that automatically and
# derives the sync URL, so you set nothing extra there.
#
# When the API runs ON the NAS, Postgres is local -- use 127.0.0.1 instead of
# the Tailscale address. No network hop, and no dependency on the tailnet.

# --- App ----------------------------------------------------------------
# Port the API listens on. Change freely -- 8000 is only a convention and can
# clash with other things on a NAS. Do NOT set this on Railway/Render: they
# inject their own and the Dockerfile already honours it.
PORT=8000

DEVICE_ID_HEADER=X-Device-Id
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
ENVIRONMENT=development

# --- Public deployment only ---------------------------------------------
# Leave BOTH empty/0 for local development; they change nothing when unset.
#
# API_KEY: shared secret the app must send as X-API-Key. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Honest limitation: this key ships inside the mobile app and can be
#   extracted from the bundle. It stops bots and drive-by traffic, not a
#   determined attacker. It is not a substitute for real authentication.
API_KEY=
API_KEY_HEADER=X-API-Key

# Requests per minute per client IP. 0 disables. 60 is generous for one phone.
RATE_LIMIT_PER_MINUTE=0

# Set true ONLY when behind a tunnel/reverse proxy (Railway's edge counts), so
# the rate limiter reads the caller's real IP from X-Forwarded-For. If nothing
# trusted is in front, leaving this false is what stops callers forging that
# header to dodge limits.
TRUST_PROXY_HEADERS=false
