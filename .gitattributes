# ---------------------------------------------------------------
# Line endings: LF everywhere, so Windows and macOS checkouts stop
# producing phantom whole-file diffs.
# After pulling this file once, run: git add --renormalize .
# ---------------------------------------------------------------
* text=auto eol=lf

*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# Windows batch files must keep CRLF or cmd.exe breaks
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary -- never line-ending-converted, never diffed as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.docx  binary
*.pptx  binary
*.xlsx  binary

# Generated -- collapse in diffs and PR review
package-lock.json  -diff linguist-generated
